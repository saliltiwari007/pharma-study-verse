{
  "version": 2,
  "principles": {
    "serverAuthoritative": true,
    "clientTrust": false,
    "answerKeysPublic": false,
    "persistentScoresClientOnly": false,
    "diagnosticIsNotCredential": true
  },
  "modes": {
    "baselineDiagnostic": {
      "purpose": "measure current preparation and identify weak domains before revision",
      "resultDimensions": ["overallScore", "accuracy", "attemptedCoverage", "domainScores", "readinessBand"],
      "peerComparison": "server_only_after_shared_attempt_data_exists"
    },
    "practice": {"purpose": "learning and active recall", "ranked": false},
    "assessment": {"purpose": "controlled performance measurement", "ranked": true},
    "challenge": {"purpose": "high-discrimination competitive performance", "ranked": true}
  },
  "delivery": {
    "questionPoolSelection": "randomized",
    "optionOrder": "shuffled",
    "questionOrder": "shuffled",
    "variantGeneration": "optional",
    "attemptSession": "serverIssued",
    "timer": "serverValidated",
    "attemptLimits": "configurable",
    "cooldown": "configurable"
  },
  "integrity": {
    "recordAttemptEvents": true,
    "detectRapidPatterns": true,
    "detectRepeatedAnswerPatterns": true,
    "flagSuspiciousAttempts": true,
    "manualReview": true,
    "neverClaimPerfectAntiCheat": true
  },
  "ranking": {
    "calculatedServerSide": true,
    "eligibleAttemptsOnly": true,
    "tiesUseSecondaryMetrics": true,
    "activitySpecificRanks": true,
    "subjectSpecificRanks": true,
    "overallRank": true,
    "minimumSharedAttemptsBeforePeerPercentile": true
  }
}
